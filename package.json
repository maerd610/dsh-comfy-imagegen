{
  "name": "dsh-comfy-imagegen",
  "version": "0.2.0",
  "description": "Conversational image generation for DeepSeek Harness, backed by your local ComfyUI.",
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "templates",
    "skills",
    "scripts",
    "cordis.patch.yml",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "comfyui",
    "image-generation",
    "text-to-image",
    "stable-diffusion",
    "flux",
    "qwen-image"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "self-check": "node scripts/smoke.mjs --verbose",
    "template": "node scripts/template.mjs"
  }
}
